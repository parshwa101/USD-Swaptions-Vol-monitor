"""
Title: USD Swaption Volatility Surface & Term Structure Dashboard
Author: Parshwa Shah
Description: Institutional-grade data pipeline and visualization dashboard 
             ingesting multi-tenor swaption matrices, computing rate-of-change metrics,
             and rendering Goldman-style heatmap analytics.
"""

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

class SwaptionDataPipeline:
    def __init__(self):
        # Institutional expiries and underlying swap tenors
        self.expiries = ["1m", "3m", "6m", "1y", "2y", "3y", "5y", "7y", "10y"]
        self.tenors = ["1y", "2y", "5y", "7y", "10y", "15y", "20y", "30y"]

    def ingest_market_data(self) -> dict:
        """
        Step 1: INPUT PIPELINE
        #In production, this connects to Bloomberg API (blpapi) or OpenBB.
        Here, we ingest benchmark matrix structures matching institutional reports.
        """
        # Implied Volatility Matrix (%)
        iv_data = np.array([
            [5.55, 6.58, 6.55, 6.35, 6.13, 5.76, 5.54, 5.39],
            [5.99, 6.70, 6.46, 6.23, 5.97, 5.67, 5.50, 5.36],
            [6.63, 6.90, 6.58, 6.34, 6.07, 5.79, 5.64, 5.51],
            [7.07, 6.96, 6.60, 6.41, 6.18, 5.93, 5.80, 5.69],
            [7.01, 6.79, 6.50, 6.36, 6.21, 6.00, 5.88, 5.78],
            [6.85, 6.66, 6.43, 6.31, 6.19, 5.99, 5.87, 5.78],
            [6.47, 6.37, 6.19, 6.12, 6.06, 5.85, 5.74, 5.65],
            [6.17, 6.13, 5.95, 6.00, 5.89, 5.68, 5.58, 5.50],
            [5.90, 5.89, 5.80, 5.74, 5.68, 5.47, 5.36, 5.28]
        ])
        
        # 1-Day Change Data (bps/day bleed)
        change_1d_data = np.array([
            [-0.20, -0.21, -0.21, -0.21, -0.18, -0.18, -0.19, -0.19],
            [-0.15, -0.16, -0.12, -0.13, -0.13, -0.13, -0.13, -0.13],
            [-0.11, -0.08, -0.06, -0.07, -0.09, -0.10, -0.10, -0.10],
            [-0.14, -0.10, -0.08, -0.12, -0.10, -0.13, -0.13, -0.13],
            [-0.14, -0.14, -0.15, -0.14, -0.13, -0.14, -0.15, -0.15],
            [-0.11, -0.14, -0.15, -0.15, -0.15, -0.16, -0.16, -0.17],
            [-0.11, -0.12, -0.12, -0.12, -0.12, -0.13, -0.14, -0.15],
            [-0.12, -0.11, -0.11, -0.11, -0.11, -0.12, -0.13, -0.14],
            [-0.11, -0.11, -0.12, -0.12, -0.12, -0.13, -0.14, -0.14]
        ])

        # 1-Month Change Data (compression)
        change_1m_data = np.array([
            [0.16, 0.83, 1.30, 1.65, 1.48, 1.45, 1.33, 1.25],
            [0.39, 0.87, 1.18, 1.27, 1.33, 1.20, 1.13, 1.07],
            [0.58, 0.85, 1.09, 1.13, 1.12, 1.04, 0.99, 0.95],
            [0.81, 0.87, 0.98, 1.01, 1.00, 0.95, 0.91, 0.88],
            [0.87, 0.80, 0.91, 0.93, 0.94, 0.88, 0.84, 0.81],
            [0.84, 0.77, 0.84, 0.86, 0.87, 0.81, 0.77, 0.74],
            [0.68, 0.66, 0.69, 0.70, 0.72, 0.66, 0.63, 0.60],
            [0.56, 0.56, 0.58, 0.59, 0.60, 0.55, 0.52, 0.49],
            [0.47, 0.46, 0.48, 0.48, 0.48, 0.44, 0.42, 0.40]
        ])

        return {
            "iv": pd.DataFrame(iv_data, index=self.expiries, columns=self.tenors),
            "change_1d": pd.DataFrame(change_1d_data, index=self.expiries, columns=self.tenors),
            "change_1m": pd.DataFrame(change_1m_data, index=self.expiries, columns=self.tenors)
        }

    def process_analytics(self, data: dict) -> dict:
        """
        Step 2: PROCESSING ENGINE
        Calculates key statistical summaries and flags structural anomalies.
        """
        df_iv = data["iv"]
        df_1d = data["change_1d"]
        
        max_vol = df_iv.values.max()
        min_vol = df_iv.values.min()
        mean_bleed = df_1d.values.mean()
        
        # Flagging heavy daily volatility crush (> 0.20 bps/day bleed)
        heavy_bleeds = []
        for exp in self.expiries:
            for tenor in self.tenors:
                val = df_1d.loc[exp, tenor]
                if val <= -0.20:
                    heavy_bleeds.append(f"{exp} x {tenor}: {val} bps/day")

        return {
            "max_vol": max_vol,
            "min_vol": min_vol,
            "mean_bleed": round(mean_bleed, 3),
            "heavy_bleeds": heavy_bleeds
        }

    def render_dashboard(self, data: dict):
        """
        Step 3: DASHBOARD OUTPUT LAYER
        Renders the multi-panel institutional matrix dashboard using matplotlib & seaborn.
        """
        plt.style.use('seaborn-v0_8-whitegrid' if 'seaborn-v0_8-whitegrid' in plt.style.available else 'default')
        fig = plt.figure(figsize=(16, 11), facecolor='white')
        fig.suptitle("USD Swaption Volatility Surface & Term Structure Dashboard", fontsize=16, fontweight='bold', y=0.95)

        # 2x2 Grid Layout
        gs = fig.add_gridspec(2, 2, height_ratios=[1, 1], width_ratios=[1, 1], hspace=0.3, wspace=0.25)

        ax1 = fig.add_subplot(gs[0, 0])
        ax2 = fig.add_subplot(gs[0, 1])
        ax3 = fig.add_subplot(gs[1, 0])
        ax4 = fig.add_subplot(gs[1, 1])

        # Plot 1: Implied Volatility Heatmap
        sns.heatmap(data["iv"], annot=True, fmt=".2f", cmap="RdYlGn", cbar=True, ax=ax1, linewidths=0.5, linecolor='white')
        ax1.set_title("Implied Volatility Surface (%)", fontsize=11, fontweight='bold')

        # Plot 2: 1-Day Change Heatmap (Bleed)
        sns.heatmap(data["change_1d"], annot=True, fmt=".2f", cmap="Reds_r", cbar=True, ax=ax2, linewidths=0.5, linecolor='white')
        ax2.set_title("1-Day Change (bps/day)", fontsize=11, fontweight='bold')

        # Plot 3: Term Structure Curves
        line_tenors = ["2y", "5y", "10y", "30y"]
        colors = ['#1f77b4', '#aec7e8', '#d62728', '#ff7f0e']
        for t, col in zip(line_tenors, colors):
            ax3.plot(self.expiries, data["iv"][t], marker='o', label=t, color=col, linewidth=1.5)
        ax3.set_title("Implied Volatility Term Structure", fontsize=11, fontweight='bold')
        ax3.set_xlabel("Expiry", fontsize=9)
        ax3.set_ylabel("Volatility (%)", fontsize=9)
        ax3.legend(loc='lower left', fontsize=8, ncol=4)
        ax3.set_ylim(5.0, 7.5)

        # Plot 4: 1-Month Change Heatmap (Compression)
        sns.heatmap(data["change_1m"], annot=True, fmt=".2f", cmap="Greens", cbar=True, ax=ax4, linewidths=0.5, linecolor='white')
        ax4.set_title("1-Month Change (bps/day)", fontsize=11, fontweight='bold')

        plt.tight_layout()
        plt.show()

# --- Execution Entrypoint ---
if __name__ == "__main__":
    pipeline = SwaptionDataPipeline()
    
    # Step 1: Ingest Data
    market_data = pipeline.ingest_market_data()
    
    # Step 2: Run Analytics Processing
    analytics = pipeline.process_analytics(market_data)
    print("--- PIPELINE ANALYTICS SUMMARY ---")
    print(f"Peak Volatility: {analytics['max_vol']}%")
    print(f"Min Volatility: {analytics['min_vol']}%")
    print(f"Market-Wide Average Bleed: {analytics['mean_bleed']} bps/day")
    print(f"Critical Vol Bleed Alerts: {analytics['heavy_bleeds']}\n")
    
    # Step 3: Render Dashboard UI
    print("Launching Institutional Dashboard UI...")
    pipeline.render_dashboard(market_data)
